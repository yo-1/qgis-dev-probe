[bandit]
# plugins.qgis.org 公式スキャンに対するプロジェクト設定。
#
# skips の理由:
# B102（exec の使用）は本プラグインの中核機能であり、意図的な設計である。
#   - qgis_side/handlers.py の execute_code: 既定で無効。セッションごとに
#     ユーザーが明示的に許可した場合だけ動く。
#   - core/recipes.py のレシピ読込: ローカルに置いたレシピファイル専用。
#     run_recipe は EXEC 分類で、execute_code と同じ allow_exec ゲート
#     （セッション許可制）の対象（2026-10-27 の許可経路監査を受けて変更）。
# いずれも localhost 限定・手動起動の開発専用プラグインという前提で、
# 2026-10-26 に利用者の承認を得てスキップを採用した。
# スキップは検出を消すものではない。CI はスキップなしの生レポートを
# artifact（bandit-raw-report）に残し続ける。
# critical 扱いのルール（B105-B107、B2xx の HIGH 等）は公式でもスキップ
# 不可であり、ここには書かない。問題があればコード側で直す。
skips: B102
